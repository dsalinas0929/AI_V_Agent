# Server-only settings. Export them explicitly; this file is not auto-loaded.
# Prefer `uv run agent-v serve --ask-api-key` to enter your key without saving it.
AGENT_V_PROVIDER=saygm
AGENT_V_MODEL=gpt-5.4-mini
GM_API_KEY=your-saygm-key

# Optional Gemini setup (requires AGENT_V_PROVIDER=gemini and a Gemini model ID):
# GEMINI_API_KEY=your-google-ai-studio-key
# AGENT_V_MODEL=gemini-3.8-flash

AGENT_V_DB=.agent-v/server.sqlite3
# Shared model requests per minute, across all users. Adjust to your provider quota.
AGENT_V_RPM=5

# Client terminal only: AGENT_V_TOKEN is issued by `agent-v users add`.
# It is NOT a model provider API key. Do not give clients GM_API_KEY or GEMINI_API_KEY.
